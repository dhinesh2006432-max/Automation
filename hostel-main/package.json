{
  "name": "hostel-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Hostel Room Allocation and Management System",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm run dev --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "build": "node build.cjs",
    "vercel-build": "node build.cjs",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "start": "node backend/server.js"
  },
  "keywords": [
    "hostel",
    "vercel",
    "express",
    "react",
    "vite"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.5",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
